{
  "name": "kxco-pq-hsm",
  "version": "1.4.6",
  "description": "Post-quantum key custody on the HSM you already run. ML-DSA-65 keys generated on a PKCS#11 token with CKA_EXTRACTABLE=false and signed with C_Sign, so the private key never enters host memory. ML-KEM-768 and an Argon2id file store included.",
  "keywords": [
    "post-quantum",
    "pqc",
    "hsm",
    "pkcs11",
    "ml-dsa",
    "ml-kem",
    "nist",
    "fips-203",
    "fips-204",
    "key-management",
    "kxco",
    "hardware-security-module",
    "softhsm2",
    "yubikey",
    "luna",
    "argon2",
    "key-storage",
    "zero-trust",
    "key-protection",
    "pqc-migration",
    "key-custody",
    "digital-signature",
    "thales",
    "utimaco",
    "crypto-agility",
    "pkcs-11",
    "non-extractable"
  ],
  "license": "Apache-2.0",
  "author": "Shayne Heffernan and John Heffernan",
  "contributors": [
    {
      "name": "Shayne Heffernan"
    },
    {
      "name": "John Heffernan"
    }
  ],
  "homepage": "https://kxco.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-hsm.git"
  },
  "bugs": {
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-hsm/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "src",
    "ASSESSMENT.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "kxco-post-quantum": "^1.3.0"
  },
  "optionalDependencies": {
    "pkcs11js": "^2.1.0"
  },
  "scripts": {
    "test": "node --test test/hsm.test.js test/signing-mode.test.js test/property.test.js",
    "test:softhsm": "node --test test/softhsm-integration.test.js",
    "evidence": "node scripts/build-evidence.mjs"
  },
  "funding": "https://kxco.ai",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "pkcs11js": "^2.1.6"
  }
}
