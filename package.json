{
  "name": "kxco-pq-hsm",
  "version": "1.3.2",
  "description": "ML-DSA-65 and ML-KEM-768 key custody. Private keys are encrypted at rest under an AES key your PKCS#11 token holds and never releases. Keys are generated in host memory: on-token generation is NOT implemented. Not never-leaves-the-module custody.",
  "keywords": [
    "post-quantum",
    "pqc",
    "hsm",
    "pkcs11",
    "ml-dsa",
    "ml-kem",
    "nist",
    "fips-203",
    "fips-204",
    "key-management",
    "kxco",
    "hardware-security-module",
    "softhsm2",
    "yubikey",
    "luna",
    "argon2",
    "key-storage",
    "zero-trust",
    "key-protection"
  ],
  "license": "Apache-2.0",
  "author": "Shayne Heffernan and John Heffernan",
  "contributors": [
    {
      "name": "Shayne Heffernan"
    },
    {
      "name": "John Heffernan"
    }
  ],
  "homepage": "https://kxco.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-hsm.git"
  },
  "bugs": {
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-hsm/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "kxco-post-quantum": "^1.3.0"
  },
  "optionalDependencies": {
    "pkcs11js": "^2.1.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=60000 test/hsm.test.js test/signing-mode.test.js"
  },
  "funding": "https://kxco.ai",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
}
